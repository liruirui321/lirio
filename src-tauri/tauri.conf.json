{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lirio",
  "version": "0.5.2",
  "identifier": "local.aboboo.community",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lirio",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost 'self' blob: https://lirio.deltae.tech http://127.0.0.1:8787; img-src 'self' data: blob: https://lirio.deltae.tech; media-src 'self' blob:; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "./Info.plist",
      "entitlements": "./entitlements.plist"
    },
    "resources": [
      "resources/asr/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzMUUxM0EyNTFGMzI3NzcKUldSM0ovTlJvaE1lTTRDbmdNZ3ZQUTQ5aFgyWlo5UFFFa2licXB1RkdpbHpKa0U3eHpja01rZ08K",
      "endpoints": [
        "https://lirio.deltae.tech/api/updates/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
